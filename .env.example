# ============================================
# LUA MASTER PRO - VARIABLES DE ENTORNO
# ============================================
# Copiar este archivo a .env.local
# NO subir .env.local a Git (está en .gitignore)

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Obtener en: https://app.supabase.com/project/_/settings/api

# URL de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon Key (pública, safe para cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# ============================================
# OPCIONAL: OTRAS CONFIGURACIONES
# ============================================

# URL del sitio (para redirects de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Modo debug (opcional)
NEXT_PUBLIC_DEBUG=false
